  "inference_recipe": [
    {
      "step": 1,
      "name": "load_model",
      "description": "For each ensemble member, load the corresponding .pt or .onnx from MongoDB GridFS using model_files[i].pt_file or .onnx_file. For .pt: reconstruct AnchoredCrossAttentionTFT(**member.arch), then call model.load_state_dict(ckpt['state_dict']). For .onnx: create ort.InferenceSession(path)."
    },
    {
      "step": 2,
      "name": "engineer_features",
      "description": "Compute all derived features in exactly the order defined in feature_registry.feature_cols. All feature engineering logic is documented in Cell 1 of the training notebook. The required raw inputs are: Spot_Close, Spot_Open, Spot_High, Spot_Low, Realized_Vol_Ann, VIX_Close, PCR_OI, PCR_Volume, VRP_Daily, Put_IV_25d, Call_IV_25d, Options_Skew_25d, PCR_OI, GEX_Raw, GEX_Zscore, GEX_Pos, GEX_Neg, and overnight momentum features for SP500, crude oil, and Hang Seng."
    },
    {
      "step": 3,
      "name": "scale_features",
      "description": "Apply preprocessing.var_features scaler to columns at indices feature_registry.var_feature_indices:   x_var = (x_var - mean) / scale. Apply preprocessing.dir_features scaler to columns at indices feature_registry.all_dir_indices:   x_dir = x_dir / scale  (no mean subtraction). Values are taken from the preprocessing section of this document."
    },
    {
      "step": 4,
      "name": "build_sequence_tensor",
      "description": "Stack the last 10 rows of scaled features into a tensor of shape (1, 10, 51) dtype=float32. Row 0 is the oldest observation, row -1 the most recent."
    },
    {
      "step": 5,
      "name": "compute_vol_ewma",
      "description": "From the Realized_Vol_Ann series (raw, unscaled), compute EWMA with span=10. Take the value at the current prediction date. Store as vol_ewma (scalar float)."
    },
    {
      "step": 6,
      "name": "run_ensemble_inference",
      "description": "For each ensemble member, run forward pass with the sequence tensor. For .pt models: model(x, idx_var_tensor, model_dir_idx_tensor).   idx_var_tensor    = torch.tensor(feature_registry.var_feature_indices).   model_dir_idx_tensor = torch.tensor(model_files[i].dir_feature_indices). For .onnx models: session.run(None, {'feature_sequence': x.numpy()}). Collect all 6 outputs from each member."
    },
    {
      "step": 7,
      "name": "average_ensemble_outputs",
      "description": "For each of the 6 output positions, stack predictions across all ensemble members and take the mean along the member axis. Result: 6 tensors each of shape (1, 1)."
    },
    {
      "step": 8,
      "name": "rescale_to_return_space",
      "description": "Multiply each of the 6 mean outputs by vol_ewma (for 1D horizon) or vol_ewma * sqrt(5) (for 5D horizon). Do NOT rescale aux_pred \u2014 it is used for diagnostics only. Final outputs are log-return predictions."
    },
    {
      "step": 9,
      "name": "label_outputs",
      "description": "Name outputs using output_spec.output_names and output_spec.ci_bands. Do NOT hardcode 'hr_85' or any CI number \u2014 use the generic band names (q_lower_outer, q_upper_outer, etc.) and reference output_spec.ci_bands.outer.ci_pct when a human-readable label is needed."
    }
  ],
